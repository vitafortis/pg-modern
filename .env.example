# Where the encrypted store and key file live.
PGM_DATA_DIR=./data

# Optional master secret. If unset, a random 256-bit key is written to $PGM_DATA_DIR/secret.key.
# PGM_SECRET_KEY=

# Comma-separated folders to scan for .env and compose files (more can be added in the UI).
# PGM_SCAN_PATHS=/opt/stacks,~/docker
# PGM_SCAN_DEPTH=6

# Docker endpoints. Defaults to the local socket when one exists.
# PGM_DOCKER_HOSTS=unix:///var/run/docker.sock,tcp://10.0.0.5:2375

# Read projects from Arcane instead of mounting folders.
# Key permissions needed: environments:list, projects:list, projects:read
# PGM_ARCANE_URL=https://arcane.home.arpa
# PGM_ARCANE_API_KEY=arc_…

# Query limits.
# PGM_STATEMENT_TIMEOUT_MS=30000
# PGM_MAX_ROWS=5000

# Create the first admin on start instead of using the setup wizard.
# PGM_ADMIN_EMAIL=you@example.com
# PGM_ADMIN_PASSWORD=
# PGM_ADMIN_NAME=

# Set to "disabled" to skip the login screen (trusted networks only).
# PGM_AUTH=disabled

# Hide the email/password form once SSO works.
# PGM_LOCAL_LOGIN=disabled

# Single sign-on (OIDC). Register <your-url>/auth/oidc/callback as the redirect URI.
# PGM_OIDC_ISSUER=https://auth.example.com/application/o/pg-modern/
# PGM_OIDC_CLIENT_ID=pg-modern
# PGM_OIDC_CLIENT_SECRET=
# PGM_OIDC_NAME=Authentik
# PGM_OIDC_SCOPES=openid email profile
# Who gets an account on first login, and who of those is an admin (others: viewer).
# PGM_OIDC_AUTO_CREATE=*@example.com,friend@gmail.com
# PGM_OIDC_ADMIN_EMAILS=you@example.com
# PGM_OIDC_DEFAULT_ROLE=viewer
